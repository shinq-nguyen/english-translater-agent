{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/guard_ticket_commit.py",
            "command_windows": "python .codex/hooks/guard_ticket_commit.py",
            "timeout": 10,
            "statusMessage": "Checking commit message against active ticket"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/ticket_audit.py",
            "command_windows": "python .codex/hooks/ticket_audit.py",
            "timeout": 10,
            "statusMessage": "Writing ticket-workflow audit log entry",
            "async": true
          }
        ]
      }
    ]
  }
}
