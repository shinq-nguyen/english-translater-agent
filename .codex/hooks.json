{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/block_secrets.py",
            "command_windows": "python .codex/hooks/block_secrets.py",
            "timeout": 10,
            "statusMessage": "Checking command against .env-file policy"
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/rewrite_pytest.py",
            "command_windows": "python .codex/hooks/rewrite_pytest.py",
            "timeout": 10,
            "statusMessage": "Checking for a pytest command to rewrite"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/audit_log.py",
            "command_windows": "python .codex/hooks/audit_log.py",
            "timeout": 10,
            "statusMessage": "Recording proposed tool call"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/audit_log.py",
            "command_windows": "python .codex/hooks/audit_log.py",
            "timeout": 10,
            "statusMessage": "Recording tool result"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/scan_prompt_secrets.py",
            "command_windows": "python .codex/hooks/scan_prompt_secrets.py",
            "timeout": 10,
            "statusMessage": "Scanning prompt for pasted tokens/keys"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/audit_log.py",
            "command_windows": "python .codex/hooks/audit_log.py",
            "timeout": 10,
            "statusMessage": "Recording prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/audit_log.py",
            "command_windows": "python .codex/hooks/audit_log.py",
            "timeout": 30,
            "statusMessage": "Recording assistant response and transcript"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/audit_log.py",
            "command_windows": "python .codex/hooks/audit_log.py",
            "timeout": 10,
            "statusMessage": "Recording subagent start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/audit_log.py",
            "command_windows": "python .codex/hooks/audit_log.py",
            "timeout": 30,
            "statusMessage": "Recording subagent response"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/audit_log.py",
            "command_windows": "python .codex/hooks/audit_log.py",
            "timeout": 10,
            "statusMessage": "Recording session start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/audit_log.py",
            "command_windows": "python .codex/hooks/audit_log.py",
            "timeout": 3,
            "statusMessage": "Recording session end"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/audit_log.py",
            "command_windows": "python .codex/hooks/audit_log.py",
            "timeout": 10,
            "statusMessage": "Recording pre-compaction state"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/audit_log.py",
            "command_windows": "python .codex/hooks/audit_log.py",
            "timeout": 10,
            "statusMessage": "Recording post-compaction state"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/audit_log.py",
            "command_windows": "python .codex/hooks/audit_log.py",
            "timeout": 3,
            "statusMessage": "Recording interrupted turn"
          }
        ]
      }
    ]
  }
}
